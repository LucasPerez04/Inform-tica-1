#define NVALIDADORES (int)(sizeof(validadores) / sizeof(validadores[0]))

void normalizar(const char *src, char *dst, const char *ignorar) {
    int j = 0;
    for (int i = 0; src[i] != '\0'; i++)
        if (!strchr(ignorar, src[i]) || ignorar[0] == '\0')
            dst[j++] = src[i];
    dst[j] = '\0';
}

int ejecutar(const DFA *d, const char *entrada) {
    char limpio[100];
    normalizar(entrada, limpio, d->ignorar);

    int estado = 0;
    printf("  Recorrido: q0");
    for (int i = 0; limpio[i] != '\0'; i++) {
        estado = d->tabla[estado][clasificar(limpio[i])];
        if (estado == E) {
            printf(" -> ERROR en '%c'\n", limpio[i]);
            return 0;
        }
        printf(" -> q%d", estado);
    }
    printf("\n");
    return d->aceptacion[estado];
}

int main(void) {
    int opcion;
    char buffer[100];

    do {
        printf("\n===== VALIDADOR DE FORMULARIOS (DFA) =====\n");
        for (int i = 0; i < NVALIDADORES; i++)
            printf("%d. %s (ej. %s)\n", i + 1, validadores[i].nombre, validadores[i].ejemplo);
        printf("0. Salir\nOpcion: ");

        if (scanf("%d", &opcion) != 1) break;
        getchar();

        if (opcion >= 1 && opcion <= NVALIDADORES) {
            const DFA *d = &validadores[opcion - 1];
            printf("Ingrese %s: ", d->nombre);
            fgets(buffer, sizeof(buffer), stdin);
            buffer[strcspn(buffer, "\n")] = 0;

            printf("  %s\n", ejecutar(d, buffer) ? "Resultado: VALIDO (ACEPTADA)"
                                                  : "Resultado: INVALIDO (RECHAZADA)");
        } else if (opcion != 0) {
            printf("Opcion no valida.\n");
        }
    } while (opcion != 0);

    return 0;
}
