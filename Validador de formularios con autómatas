#include <stdio.h>
#include <string.h>
#include <ctype.h>
#define E -1
#define NCLASES 8

enum { C_CERO, C_NUEVE, C_DIG, C_LET, C_ARROBA, C_PUNTO, C_SEP, C_OTRO };

int clasificar(char c) {
    if (c == '0') return C_CERO;
    if (c == '9') return C_NUEVE;
    if (isdigit((unsigned char)c)) return C_DIG;
    if (isalpha((unsigned char)c)) return C_LET;
    if (c == '@') return C_ARROBA;
    if (c == '.') return C_PUNTO;
    if (c == '-' || c == '_') return C_SEP;
    return C_OTRO;
}

typedef struct {
    const char *nombre;
    const char *ejemplo;
    const char *ignorar;
    int tabla[12][NCLASES];
    int aceptacion[12];          
} DFA;

